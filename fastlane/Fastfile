require "base64"
require "fileutils"

APP_IDENTIFIER = "com.jirathip.morsel".freeze

# Info.plist source for the Morsel app target (app/project.yml sets the
# target-scoped INFOPLIST_FILE to this committed, no-value template). The lane
# temporarily populates its $(MORSEL_*) placeholders and restores the template
# in an ensure block, so values live only in the plist FILE — never in
# xcodebuild/Fastlane command lines or logs.
MORSEL_INFO_PLIST = File.expand_path("Morsel-Info.plist", __dir__).freeze

# Escape a value for embedding as a literal string in an XML Info.plist.
def morsel_xml_escape(value)
  value.gsub("&", "&amp;").gsub("<", "&lt;").gsub(">", "&gt;").gsub('"', "&quot;")
end

# Read and validate the Supabase TestFlight configuration. Fails fast with
# names-only diagnostics when a value is missing or empty; never prints values.
def morsel_supabase_values
  supabase_url = ENV.fetch("SUPABASE_URL", "").strip
  anon_key = ENV.fetch("SUPABASE_ANON_KEY", "").strip
  missing = []
  missing << "SUPABASE_URL" if supabase_url.empty?
  missing << "SUPABASE_ANON_KEY" if anon_key.empty?
  unless missing.empty?
    UI.user_error!(
      "Missing required TestFlight configuration: #{missing.join(', ')}. " \
      "Set the SUPABASE_URL and SUPABASE_ANON_KEY repository secrets."
    )
  end
  mcp_url = "#{supabase_url.sub(%r{/+\z}, '')}/functions/v1/mcp"
  { url: supabase_url, anon_key: anon_key, mcp_url: mcp_url }
end

# Yield with the Morsel Info.plist source populated with the Supabase values,
# then restore the committed no-value template in all cases (success or
# failure). The values reach the built product through the plist FILE only.
def with_morsel_supabase_plist
  values = morsel_supabase_values
  template = File.binread(MORSEL_INFO_PLIST)
  populated = template
    .gsub("$(MORSEL_SUPABASE_URL)") { morsel_xml_escape(values[:url]) }
    .gsub("$(MORSEL_SUPABASE_ANON_KEY)") { morsel_xml_escape(values[:anon_key]) }
    .gsub("$(MORSEL_MCP_URL)") { morsel_xml_escape(values[:mcp_url]) }
  File.binwrite(MORSEL_INFO_PLIST, populated)
  yield
ensure
  File.binwrite(MORSEL_INFO_PLIST, template) if template
end

default_platform(:ios)

platform :ios do
  desc "Build Morsel and upload it to TestFlight"
  lane :native_beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH")
    )

    if ENV["CI"]
      setup_ci
      cert_path = File.expand_path("certs/dist.p12", __dir__)
      FileUtils.mkdir_p(File.dirname(cert_path))
      File.binwrite(cert_path, Base64.decode64(ENV.fetch("IOS_DIST_CERT_P12")))
      import_certificate(
        certificate_path: cert_path,
        certificate_password: ENV.fetch("IOS_DIST_CERT_PASSWORD"),
        keychain_name: "fastlane_tmp_keychain",
        keychain_password: ""
      )
    else
      get_certificates(api_key: api_key, output_path: "fastlane/certs")
    end

    app_id = Spaceship::ConnectAPI::BundleId.all(filter: { identifier: APP_IDENTIFIER })
      .find { |candidate| candidate.identifier == APP_IDENTIFIER }
    unless app_id
      app_id = Spaceship::ConnectAPI::BundleId.create(
        name: "Morsel", identifier: APP_IDENTIFIER, platform: "IOS"
      )
    end
    capabilities = Spaceship::ConnectAPI::BundleIdCapability.all(bundle_id_id: app_id.id)
      .map(&:capability_type)
    unless capabilities.include?("APPLE_ID_AUTH")
      Spaceship::ConnectAPI::BundleIdCapability.create(
        bundle_id_id: app_id.id,
        capability_type: "APPLE_ID_AUTH",
        settings: [{
          key: "APPLE_ID_AUTH_APP_CONSENT",
          options: [{ key: "PRIMARY_APP_CONSENT", enabled: true }]
        }]
      )
    end
    unless capabilities.include?("HEALTHKIT")
      Spaceship::ConnectAPI::BundleIdCapability.create(
        bundle_id_id: app_id.id,
        capability_type: "HEALTHKIT"
      )
    end

    unless Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
      Spaceship::ConnectAPI::App.create(
        name: "Morsel", bundle_id: APP_IDENTIFIER, primary_locale: "en-US",
        sku: "MORSEL", platforms: ["IOS"], version_string: "1.0.0"
      )
    end

    get_provisioning_profile(
      api_key: api_key, app_identifier: APP_IDENTIFIER, force: true,
      output_path: "fastlane/certs"
    )
    profile = lane_context[SharedValues::SIGH_NAME]
    update_code_signing_settings(
      path: "app/Morsel.xcodeproj",
      use_automatic_signing: false,
      team_id: "9244PWFYD7",
      code_sign_identity: "Apple Distribution",
      profile_name: profile,
      targets: ["Morsel"],
      build_configurations: ["Release"]
    )
    build = latest_testflight_build_number(
      api_key: api_key, app_identifier: APP_IDENTIFIER, initial_build_number: 0
    ) + 1
    key_path = File.expand_path(File.basename(ENV.fetch("ASC_KEY_PATH")), __dir__)
    export_auth_args = "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')} " \
      "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')} " \
      "-authenticationKeyPath #{key_path} -allowProvisioningUpdates"

    with_morsel_supabase_plist do
      gym(
        project: "app/Morsel.xcodeproj",
        scheme: "Morsel",
        configuration: "Release",
        export_method: "app-store",
        xcargs: "CURRENT_PROJECT_VERSION=#{build}",
        export_xcargs: export_auth_args,
        export_options: {
          signingStyle: "manual",
          signingCertificate: "Apple Distribution",
          provisioningProfiles: { APP_IDENTIFIER => profile }
        }
      )
    end
    upload_to_testflight(
      api_key: api_key, app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: true
    )
    UI.success("Uploaded Morsel build #{build} to TestFlight (#{APP_IDENTIFIER}).")
  end
end
